{
  "name": "dsh-general-agentics",
  "version": "0.2.0-alpha.33",
  "description": "General Agentics distribution bundle for DeepSeek Harness (DSH): one install brings the General Agentics white-label brand, curated plugins, bundled skills, and MCP pre-configuration. Built on DeepSeek Harness (DSH).",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Bryan-cmf/dsh-general-agentics.git"
  },
  "bugs": {
    "url": "https://github.com/Bryan-cmf/dsh-general-agentics/issues"
  },
  "homepage": "https://github.com/Bryan-cmf/dsh-general-agentics#readme",
  "type": "module",
  "main": "lib/index.js",
  "engines": {
    "dsh": ">=0.2.1-rc.2"
  },
  "scripts": {
    "test": "node --test test/bundle-manifest.test.mjs test/client-panel.test.mjs test/ga-status.test.mjs test/settings-panel.test.mjs test/skill-provider.test.mjs",
    "check-upstream": "node scripts/check-upstream.mjs",
    "check-dsh-compat": "node scripts/check-dsh-compat.mjs",
    "prepublish-check": "node scripts/prepublish-check.mjs",
    "prepublishOnly": "npm run prepublish-check",
    "ci": "npm test && npm run review && npm pack --dry-run",
    "review": "node scripts/review.mjs"
  },
  "files": [
    "CHANGELOG.md",
    "README.md",
    "brand",
    "cordis.patch.yml",
    "lib",
    "mcp",
    "skills"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "cordis-plugin",
    "dsh-plugin",
    "dsh-bundle",
    "white-label"
  ],
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-modules"
      ]
    }
  },
  "dependencies": {
    "@changfenhuang/dsh-genui": "^0.12.0",
    "@liustack/modlens": "^3.27.1",
    "@liustack/modsearch": "^5.10.7",
    "@ricardochen1996/dsh-browser-use": "^0.6.2",
    "@xmanrui/dsh-im": "^4.39.0",
    "dsh-better-sidebar": "^0.28.0",
    "dsh-comments": "^0.6.1",
    "dsh-context": "^0.73.0",
    "dsh-cost-meter": "^1.8.36",
    "dsh-mobile": "^0.6.11",
    "dsh-promptimizer": "^0.1.4",
    "dsh-sentinel": "^0.11.1",
    "dshmarket": "^1.66.35"
  }
}
